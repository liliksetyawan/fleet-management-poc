FROM golang:1.23-alpine AS builder
WORKDIR /src
COPY go.mod ./
COPY . .
RUN go mod tidy
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -o /out/fleet-publisher ./cmd/publisher
FROM alpine:3.21
RUN apk add --no-cache ca-certificates
COPY --from=builder /out/fleet-publisher /usr/local/bin/fleet-publisher
ENTRYPOINT ["/usr/local/bin/fleet-publisher"]
